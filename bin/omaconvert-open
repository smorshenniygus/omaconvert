#!/usr/bin/env python3
"""Open a file in OmaConvert: omaconvert-open [FILE | file:// URI].

Used by the desktop entry (Exec=... %f) for "Open With" and by scripts.
Without an argument it just shows the window.
"""
from pathlib import Path
import sys

# Never write __pycache__ into the plugin folder: the Omarchy shell reloads
# every plugin when a file changes there, closing the window just opened.
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from lib.launcher import open_in_shell


def main():
    try:
        open_in_shell(sys.argv[1:])
    except (OSError, RuntimeError) as exc:
        print(f"omaconvert-open: {exc}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
