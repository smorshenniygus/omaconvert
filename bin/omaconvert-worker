#!/usr/bin/env python3
"""Private entrypoint. Verify kernel limits before importing the media pipeline."""
import os
from pathlib import Path
import signal
import sys
import threading
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))
from lib.confinement import verify_worker, ProtectionUnavailable
from lib.events import EventSink


def main():
    try:
        unit, memory = sys.argv[1:3]
        verify_worker(unit, int(memory))
        if os.read(0, 3) != b'go\n':
            raise ProtectionUnavailable('Controller did not admit the worker.')
    except (ValueError, ProtectionUnavailable) as exc:
        EventSink().emit('error',reason='protection-unavailable',message=str(exc))
        return 2
    # EOF means controller died, including while a codec has gone silent.
    def parent_watch():
        os.read(0, 1)
        os.kill(os.getpid(), signal.SIGKILL)
    threading.Thread(target=parent_watch,daemon=True).start()
    from lib.cleanup import set_job
    set_job(unit)
    from lib.cli import run_worker
    return run_worker(sys.argv[3:])

if __name__ == '__main__':
    sys.exit(main())
