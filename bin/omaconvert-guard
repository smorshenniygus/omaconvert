#!/usr/bin/env python3
"""Tiny independent lifetime owner. EOF stops *all* descendants of one scope.

This process deliberately survives controller death. No media is processed
here; it holds only a pipe and the generated unit name, with fixed limits.
"""
import os
import re
import resource
import subprocess
import sys


def main():
    if len(sys.argv) != 3 or not re.fullmatch(r'omaconvert-job-[0-9a-f]{32}\.scope',sys.argv[2]):
        return 2
    expected=int(sys.argv[1]);unit=sys.argv[2]
    resource.setrlimit(resource.RLIMIT_AS,(128*1024**2,128*1024**2))
    resource.setrlimit(resource.RLIMIT_CPU,(5,5))
    os.write(1,b"ready\n")
    if os.getppid()==expected:
        # Writer belongs only to the controller: tools cannot keep it alive.
        os.read(0,1)
    for operation in (['kill','--signal=KILL','--kill-whom=all',unit],['stop',unit]):
        try:
            subprocess.run(['/usr/bin/systemctl','--user',*operation],stdin=subprocess.DEVNULL,
                           stdout=subprocess.DEVNULL,stderr=subprocess.DEVNULL,timeout=4)
        except (OSError,subprocess.SubprocessError):pass
    return 0

if __name__=='__main__':sys.exit(main())
