#!/usr/bin/env python3
"""Run one media tool so that it dies with the OmaConvert backend.

usage: omaconvert-exec BACKEND_PID TOOL [ARGS...]

The backend starts this helper instead of running the tool directly. The helper
asks Linux to SIGKILL it when the backend (the thread that started it) dies,
checks that the backend is still alive, and replaces itself with the tool. The
setting survives exec, so the tool inherits it.

This replaces a Python callback between fork and exec (Popen's preexec_fn),
which Python documents as unsafe in a program with threads.

Deliberately standalone: it is started with `python -I -S`, imports nothing
from the plugin and writes no bytecode. Problems go to stderr; exit status 127
means the tool could not be started."""
import ctypes
import os
import signal
import sys

PR_SET_PDEATHSIG = 1
EXIT_NOT_STARTED = 127


def main(argv):
    if len(argv) < 3 or not argv[1].isdigit():
        print("omaconvert-exec: usage: omaconvert-exec BACKEND_PID TOOL [ARGS...]", file=sys.stderr)
        return 2
    backend, command = int(argv[1]), argv[2:]

    # Python ignores these two for itself and exec would hand that on. Popen
    # restored the defaults for this process; do the same for the tool.
    for number in (signal.SIGPIPE, signal.SIGXFSZ):
        signal.signal(number, signal.SIG_DFL)

    try:
        armed = ctypes.CDLL(None, use_errno=True).prctl(PR_SET_PDEATHSIG, signal.SIGKILL, 0, 0, 0) == 0
    except (OSError, AttributeError):
        armed = False
    if not armed:
        print("omaconvert-exec: warning: the tool will not stop if the backend is killed", file=sys.stderr)
    # The backend may have died before the signal was armed; it would never
    # be delivered, so there is nothing left to run the tool for.
    if os.getppid() != backend:
        os.kill(os.getpid(), signal.SIGKILL)

    try:
        os.execvp(command[0], command)
    except OSError as exc:
        print(f"omaconvert-exec: cannot start {command[0]!r}: {exc.strerror or exc}", file=sys.stderr)
        return EXIT_NOT_STARTED


if __name__ == "__main__":
    sys.exit(main(sys.argv))
