#!/usr/bin/env python3
from pathlib import Path
import sys

# Never write __pycache__ into the plugin folder: the Omarchy shell reloads
# every plugin when a file changes there, closing the window just opened.
sys.dont_write_bytecode = True
sys.path.insert(0, str(Path(__file__).resolve().parents[1]))

from lib.cli import main


if __name__ == "__main__":
    sys.exit(main())
